HTTP_PORT=8080
# development | dev | local — aktifkan log request/response (APP_ENV atau DEV_MODE=true atau LOG_LEVEL=debug)
APP_ENV=development
# Hanya jika `go run` di host DAN Postgres di-publish ke host (lihat README)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/addon_digiflazz?sslmode=disable
# Stack penuh Docker Compose: host DB = nama service `postgres` (di-override di docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/addon_digiflazz?sslmode=disable

DIGIFLAZZ_API_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_CALLBACK_URL=https://api.digiflazz.com/v1/seller/callback

ATRILINKS_BASE_URL=http://api.atrilinks.com
ATRILINKS_USER_ID=
# Untuk BLAKE3 sign: combined = reqid|kode|tujuan:userid:password:pin:Atrilinks
ATRILINKS_PASS=
ATRILINKS_PIN=

ADDON_ATRILINKS_CALLBACK_URL=https://your-addon.example/h2h/atrilinks/callback

# Rekonsiliasi pending (checktoday) bila callback Atrilinks gagal
PENDING_WORKER_ENABLED=true
PENDING_WORKER_INTERVAL_SEC=120
PENDING_WORKER_BATCH_SIZE=50
PENDING_RECONCILE_MIN_AGE_SEC=30
PENDING_RECONCILE_THROTTLE_SEC=60
RECONCILE_TIMEZONE=Asia/Jakarta
